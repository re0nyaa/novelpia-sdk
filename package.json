{
    "name": "novelpia",
    "version": "1.1.0",
    "description": "Novelpia 비공식 TypeScript API 클라이언트",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "module": "./dist/index.js",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.js"
        },
        "./client": {
            "types": "./dist/src/client.d.ts",
            "import": "./dist/src/client.js",
            "require": "./dist/src/client.js"
        },
        "./types": {
            "types": "./dist/src/types.d.ts",
            "import": "./dist/src/types.js",
            "require": "./dist/src/types.js"
        },
        "./errors": {
            "types": "./dist/src/errors.d.ts",
            "import": "./dist/src/errors.js",
            "require": "./dist/src/errors.js"
        },
        "./cache": {
            "types": "./dist/src/cache.d.ts",
            "import": "./dist/src/cache.js",
            "require": "./dist/src/cache.js"
        },
        "./retry": {
            "types": "./dist/src/retry.d.ts",
            "import": "./dist/src/retry.js",
            "require": "./dist/src/retry.js"
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "test": "jest --config jest.config.cjs",
        "build": "tsc -p tsconfig.build.json",
        "example:basic": "tsx examples/01-basic-search.ts",
        "example:advanced": "tsx examples/02-advanced-search.ts",
        "example:curation": "tsx examples/03-curation.ts",
        "example:pagination": "tsx examples/04-pagination.ts",
        "example:error": "tsx examples/05-error-handling.ts",
        "prepublishOnly": "npm run build && npm run test"
    },
    "keywords": [
        "novelpia",
        "novels",
        "api",
        "client",
        "typescript",
        "korean",
        "storytelling"
    ],
    "author": "re0nyaa",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/ren0yaa/novelpia.git"
    },
    "bugs": {
        "url": "https://github.com/ren0yaa/novelpia/issues"
    },
    "homepage": "https://github.com/ren0yaa/novelpia#readme",
    "devDependencies": {
        "@types/jest": "^30.0.0",
        "jest": "^30.3.0",
        "ts-jest": "^29.4.9",
        "tsx": "^4.21.0",
        "typescript": "^6.0.2"
    },
    "dependencies": {
        "undici": "^8.0.2"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}
